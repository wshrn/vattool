{
  "$schema": "https://schema.tauri.app/config/2",
  "package": {
    "productName": "Python环境助手",
    "version": "0.1.0"
  },
  "tauri": {
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "知攻系统-环境助手",
        "width": 1200,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "center": true,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false
      }
    ],
    "bundle": {
      "identifier": "com.zhigong.pythonhelper",
      "icon": [
        "icons/app-icon.ico"
      ]
    },
    "updater": {
      "active": false
    },
    "security": {
      "csp": null
    }
  },
  "build": {
    "beforeDevCommand": "vite",
    "beforeBuildCommand": "vite build",
    "devPath": "http://localhost:1420",
    "distDir": "dist"
  }
}
