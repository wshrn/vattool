{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Python 环境初始化工具",
  "version": "0.1.0",
  "identifier": "com.zhigong.vattool",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm dev",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "tauri": {
    "allowlist": {
      "all": true
    },
    "windows": [
      {
        "title": "知攻系统-Python环境工具",
        "width": 1200,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "center": true,
        "fullscreen": false,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
