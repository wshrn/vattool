{
  "$schema": "https://tauri.app/schema.json",
  "build": {
    "beforeDevCommand": "vite dev",
    "beforeBuildCommand": "vite build",
    "devPath": "http://localhost:5173",
    "distDir": "../dist"
  },
  "package": {
    "productName": "知攻系统Python环境助手",
    "version": "0.1.0"
  },
  "tauri": {
    "bundle": {
      "active": true,
      "targets": "all",
      "icon": [
        "icons/icon.ico",
        "icons/icon.png",
        "icons/icon.icns"
      ]
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "知攻系统 - Python 环境助手",
        "width": 1200,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "center": true,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
