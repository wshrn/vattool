{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Python 环境初始化助手",
  "version": "0.1.0",
  "identifier": "com.vattool.pythonenv",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "知攻系统-Python 环境初始化助手",
        "width": 1200,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "center": true,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/app-icon.ico"
    ]
  }
}
